# Harness Sidecar 本地配置。复制为 services/pixelflow-agent-harness/.env 后按本机环境填写；该文件只注入 Sidecar。

# 用途：指定唯一活动 Skill 根（相对仓库根）；影响：Sidecar 只从该目录快照 Skill。
PIXELFLOW_AGENT_HOME=backend/skills
# 用途：指定 Gateway Tool Broker 内部地址；影响：Sidecar 只能通过此地址请求业务 Tool。
PIXELFLOW_TOOL_BROKER_BASE_URL=http://127.0.0.1:8001
# 用途：声明本地 Sidecar 审计身份；影响：写入每次 Tool Call 的服务身份。
PIXELFLOW_SIDECAR_INSTANCE_ID=pixelflow-sidecar-local

# 用途：固定 Sidecar 模型档案合同；影响：必须与 Gateway .env 中的四项完全一致。
PIXELFLOW_HARNESS_PROFILE_NAME=deepseek-v4-pro
PIXELFLOW_HARNESS_MODEL_ID=deepseek-v4-flash-vision-exp
PIXELFLOW_HARNESS_CAPABILITY_VERSION=deepseek-direct-v1
PIXELFLOW_HARNESS_BUDGET_VERSION=video-budget-v1

# 用途：模型访问 Secret；影响：必须由开发者本机填写，禁止提交真实值。
DEEPSEEK_API_KEY=
# 用途：模型 Provider 地址；影响：只由 Sidecar 使用，不传给 Gateway。
DEEPSEEK_BASE_URL=https://api.deepseek.com
