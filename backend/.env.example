# PixelFlow 现在的主配置入口是 config.dev.yml / config.prod.yml。
# 这个文件只保留给兼容旧工具或临时覆盖参考，不再建议把常规配置写在 .env 里。

# 选择 profile；dev 会加载 config.dev.yml，prod 会加载 config.prod.yml。
PIXELFLOW_CONFIG_ENV=dev

# 显式指定配置文件；设置后优先级高于 PIXELFLOW_CONFIG_ENV。
# PIXELFLOW_CONFIG_FILE=/absolute/path/to/config.prod.yml

# 临时覆盖网关端口；如果不设置，则读取 YAML 里的 gateway.port。
# GATEWAY_PORT=8001

# 临时覆盖业务 MySQL；如果不设置，则读取 YAML 里的 pixelflow.mysql_url。
# PIXELFLOW_MYSQL_URL=mysql+asyncmy://user:password@host:3306/pixelflow?charset=utf8mb4

# 临时覆盖媒体生成供应商；当前仅支持 borgrise，通常直接在 YAML 里配置即可。
# PIXELFLOW_MEDIA_SKILL=borgrise

# 临时覆盖 Borgrise/content-app API 根地址；如果不设置，则读取 YAML 里的 borgrise.base_url。
# 代码会用这个地址调用生成接口，也会自动拼接 /auth/verify 做登录态校验。
# BORGRISE_BASE_URL=https://test-video.borgrise.com/api

# 临时覆盖登录态远程校验开关和超时；通常直接在 YAML 里的 borgrise.* 配置即可。
# BORGRISE_REMOTE_VERIFY_ENABLED=true
# BORGRISE_VERIFY_TIMEOUT_SECONDS=10

# 临时覆盖 Borgrise 异步任务轮询超时；通常直接在 YAML 里的 borgrise.* 配置即可。
# 视频生成任务默认最多等 1 小时。
# BORGRISE_VIDEO_POLL_TIMEOUT=3600
# 图片生成任务默认最多等 10 分钟。
# BORGRISE_IMAGE_POLL_TIMEOUT=600
# 视频分析/参考视频拆解任务默认最多等 20 分钟。
# BORGRISE_VIDEO_ANALYSIS_POLL_TIMEOUT=1200

# 开启 M5 content-app 视频 Provider；影响：Gateway 发布 generate_scenes 并由 M06 在进程外持续轮询。
# PIXELFLOW_M06_VIDEO_PROVIDER_ENABLED=true
# 轮询既有 Provider Job 的服务级 Bearer，仅允许部署 Secret 注入；影响：缺失时恢复轮询失败关闭。
# PIXELFLOW_CONTENT_APP_STATUS_AUTHORIZATION=Bearer <service-token>
# 冻结 Provider 路由摘要；影响：同一 Operation attempt 不会在中途切换厂商或能力档案。
# PIXELFLOW_M06_VIDEO_PROVIDER_ID=content-app-video
# PIXELFLOW_M06_VIDEO_PROVIDER_PROFILE_VERSION=v1
