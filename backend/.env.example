# Gateway 本地配置。复制为 backend/.env 后按本机环境填写；该文件由 scripts/start-local-pixelflow.sh 仅注入 Gateway。

# 用途：选择 Gateway 配置 profile；影响：本地联调使用 config.dev.yml。
PIXELFLOW_CONFIG_ENV=dev
# 用途：指定本地 Sidecar 地址；影响：Gateway 只向该内部地址创建 Harness Run。
PIXELFLOW_HARNESS_SIDECAR_BASE_URL=http://127.0.0.1:8090
# 用途：声明本地 Gateway 审计身份；影响：写入 Gateway→Sidecar 服务 JWT。
PIXELFLOW_GATEWAY_INSTANCE_ID=pixelflow-gateway-local

# 用途：固定 Gateway 模型档案合同；影响：必须与 Sidecar .env 中的四项完全一致。
PIXELFLOW_HARNESS_PROFILE_NAME=deepseek-v4-pro
PIXELFLOW_HARNESS_MODEL_ID=deepseek-v4-flash-vision-exp
PIXELFLOW_HARNESS_CAPABILITY_VERSION=deepseek-direct-v1
PIXELFLOW_HARNESS_BUDGET_VERSION=video-budget-v1

# 用途：配置 content-app API 根地址，必须含 /api，禁止等号后空格和行内注释。
# 影响：登录校验与生图/生视频都请求该根。当前 ec：http://creator.vitamazing.top/api。
BORGRISE_BASE_URL=http://creator.vitamazing.top/api
# 用途：启用远端登录态校验；影响：受保护的 Gateway 请求会校验当前用户授权。
BORGRISE_REMOTE_VERIFY_ENABLED=true
# 用途：启用当前图片与视频 GenerationJob Provider；影响：Gateway Worker 才会创建并轮询真实 Provider Job。
PIXELFLOW_M06_IMAGE_PROVIDER_ENABLED=true
PIXELFLOW_M06_VIDEO_PROVIDER_ENABLED=true
# 用途：输出 Provider 脱敏结构诊断；影响：仅记录状态码、Content-Type、长度和字段路径。
PIXELFLOW_IMAGE_PROVIDER_DIAGNOSTICS=true

# 用途：启用 Mem0 长期记忆；影响：缺少 Base URL、API Key 或匿名化盐时启动脚本拒绝启动，避免空检索。
PIXELFLOW_LONG_TERM_MEMORY_ENABLED=true
# 用途：配置 Mem0 服务地址；影响：仅 Gateway 使用，地址可按环境替换。
PIXELFLOW_VOLCENGINE_MEM0_BASE_URL=https://br-valid-cony-6b9bc890.mem02.aidap-global.cn-beijing.volces.com:443
# 用途：Mem0 访问 Secret；影响：必须由开发者本机填写，禁止提交真实值。
PIXELFLOW_VOLCENGINE_MEM0_API_KEY=
# 用途：生成不可逆匿名用户标识的稳定盐；影响：同一环境必须长期保持不变，禁止提交真实值。
PIXELFLOW_LONG_TERM_MEMORY_USER_SALT=
# 用途：限制同步检索等待；影响：超时返回空投影，不阻断 Agent Run。
PIXELFLOW_LONG_TERM_MEMORY_TIMEOUT_SECONDS=3
# 用途：限制单次记忆注入条数；影响：调大将增加模型上下文。
PIXELFLOW_LONG_TERM_MEMORY_SEARCH_LIMIT=5
