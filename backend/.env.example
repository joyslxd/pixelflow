# PixelFlow business persistence.
# Use URL-encoded credentials when passwords contain special characters.
# Example password character "!" may be kept as-is, but characters like @ / : ? # should be encoded.
PIXELFLOW_MYSQL_URL=mysql+asyncmy://<user>:<password>@<host>:3306/pixelflow?charset=utf8mb4

# Optional P1 semantic memory placeholder. P0 structured preferences do not use it.
PIXELFLOW_MEM0_ENABLED=false

# Borgrise / LLM secrets are intentionally not filled in here.
BORGRISE_API_TOKEN=
ANTHROPIC_API_KEY=

# PixelFlow generation skill selection.
# Use PIXELFLOW_VIDEO_SKILL=seedance to route video generation to Ark Seedance 2.0.
# PIXELFLOW_IMAGE_SKILL defaults to seedream for image generation.
PIXELFLOW_VIDEO_SKILL=seedance
PIXELFLOW_IMAGE_SKILL=seedream
PIXELFLOW_EDIT_SKILL=ffmpeg

# Volcengine Ark Plan visual models.
# Set ARK_PLAN_API_KEY for both agent planning and visual generation, or set
# ARK_API_KEY / VOLCENGINE_ARK_API_KEY only for visual generation.
ARK_API_KEY=
VOLCENGINE_ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3

# Available video models:
# - doubao-seedance-2.0
# - doubao-seedance-2.0-fast
# - doubao-seedance-2.0-mini
# - doubao-seedance-1.5-pro
# Note: Medium package does not support Seedance 2.0 series models.
ARK_SEEDANCE_MODEL=doubao-seedance-2.0

# Available image model:
# - doubao-seedream-5.0-lite
ARK_SEEDREAM_MODEL=doubao-seedream-5.0-lite
ARK_REQUEST_TIMEOUT=180
ARK_CONNECT_TIMEOUT=120
ARK_POLL_INTERVAL=5
ARK_POLL_TIMEOUT=600
ARK_MAX_RETRIES=5

# Agent Plan key. Ark media skills also fall back to this key when ARK_API_KEY
# and VOLCENGINE_ARK_API_KEY are empty.
ARK_PLAN_API_KEY=
